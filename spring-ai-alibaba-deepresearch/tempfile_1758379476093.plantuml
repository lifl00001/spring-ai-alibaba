@startuml
title ResearcherNode Parallel Execution

participant "ResearcherNode_0" as R0
participant "ResearcherNode_1" as R1
participant "ResearcherNode_2" as R2
participant "SearchService" as SS
participant "LLM" as LLM

== 并行执行 ==
R0 -> SS : 搜索相关信息
R1 -> SS : 搜索相关信息
R2 -> SS : 搜索相关信息

R0 <- SS : 返回搜索结果
R1 <- SS : 返回搜索结果
R2 <- SS : 返回搜索结果

R0 -> LLM : 发送研究任务+搜索结果
R1 -> LLM : 发送研究任务+搜索结果
R2 -> LLM : 发送研究任务+搜索结果

== 流式响应 ==
LLM --> R0 : 流式返回研究结果
LLM --> R1 : 流式返回研究结果
LLM --> R2 : 流式返回研究结果

R0 -> "State" : 存储 researcher_content_0
R1 -> "State" : 存储 researcher_content_1
R2 -> "State" : 存储 researcher_content_2

@enduml
